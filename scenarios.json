{
  "defaults": {
    "model": "/mnt/weight/Qwen3-8B",
    "device": "10",
    "profile_root": "/home/lingmutian/tmp/profile_dir",
    "warmup_rounds": 1,
    "profile_rounds": 1,
    "environment": {
      "VLLM_COMPUTE_NANS_IN_LOGITS": "1"
    },
    "hot_sampling": {
      "max_tokens": 16,
      "temperature": 0.8,
      "top_p": 0.9,
      "top_k": 50,
      "min_p": 0.1,
      "presence_penalty": 0.2,
      "frequency_penalty": 0.2,
      "repetition_penalty": 1.1,
      "logit_bias": {
        "0": -1.0,
        "1": 0.5
      },
      "_bad_words_token_ids": [
        [0],
        [1, 2]
      ],
      "logprobs": 4,
      "prompt_logprobs": 5,
      "flat_logprobs": true,
      "structured_outputs": {
        "json": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            }
          },
          "required": [
            "answer",
            "confidence"
          ],
          "additionalProperties": false
        }
      },
      "ignore_eos": true,
      "seed": 42
    },
    "engine": {
      "max_model_len": 8192,
      "enforce_eager": true,
      "async_scheduling": true,
      "gpu_memory_utilization": 0.8,
      "tensor_parallel_size": 1,
      "max_num_seqs": 64,
      "seed": 42
    }
  },
  "scenarios": [
    {
      "id": "T1",
      "name": "MRV2 文本全功能",
      "purpose": "用一个综合文本场景覆盖基础 prefill/decode、状态更新、NaN 统计、logits 修正、JSON grammar、随机采样和 logprob 后处理。",
      "expected_operators": [
        "_gather_block_tables_kernel",
        "_compute_slot_mappings_kernel",
        "_apply_write_kernel",
        "input_batch._prepare_prefill_inputs_kernel",
        "_prepare_pos_seq_lens_kernel",
        "_get_num_sampled_and_rejected_kernel",
        "_post_update_kernel",
        "_expand_idx_mapping_kernel",
        "_num_nans_kernel",
        "_bad_words_kernel",
        "_temperature_kernel",
        "_gumbel_sample_kernel",
        "_bias_kernel",
        "_topk_log_softmax_kernel",
        "_ranks_kernel",
        "_min_p_kernel",
        "_penalties_kernel",
        "_bincount_kernel",
        "_prompt_logprobs_token_ids_kernel",
        "_apply_grammar_bitmask_kernel",
        "npu_top_k_top_p"
      ],
      "cases": [
        {
          "name": "text_all_features",
          "count": 8,
          "prompt_tokens": 256,
          "prompt_text": "Answer the question as JSON with answer and confidence fields: explain repetition in language models. ",
          "sampling": {}
        }
      ]
    },
    {
      "id": "T2",
      "name": "MRV2 Qwen3.6 Mamba Hybrid MTP",
      "purpose": "使用 Qwen3.6-35B-A3B hybrid MTP 场景覆盖 Mamba accepted-token 状态更新和 align cache 预处理；M-RoPE 和 Multi-module MTP 专属 kernel 不作为覆盖目标。",
      "expected_operators": [
        "_scatter_num_accepted_kernel",
        "precopy_mamba_align_fused_kernel"
      ],
      "model": "/mnt/weight/Qwen3.5-35B-A3B-w8a8-mtp/",
      "device": "10,11",
      "replace_hot_sampling": true,
      "engine": {
        "max_model_len": 4096,
        "tensor_parallel_size": 2,
        "quantization": "ascend",
        "enable_expert_parallel": true,
        "distributed_executor_backend": "mp",
        "gpu_memory_utilization": 0.9,
        "max_num_seqs": 8,
        "enable_prefix_caching": true,
        "mamba_cache_mode": "align",
        "speculative_config": {
          "method": "qwen3_5_mtp",
          "num_speculative_tokens": 3,
          "enforce_eager": true
        }
      },
      "cases": [
        {
          "name": "qwen36_hybrid_mtp",
          "count": 8,
          "prompt_tokens": 256,
          "prompt_text": "Explain how hybrid Mamba and attention layers cooperate during autoregressive inference. ",
          "sampling": {
            "max_tokens": 16,
            "temperature": 0.0,
            "ignore_eos": true,
            "seed": 42
          }
        }
      ]
    },
    {
      "id": "T3",
      "name": "MRV2 EAGLE3 Spec Decode",
      "purpose": "覆盖 autoregressive draft prefill、draft decode、draft state 更新、sampled/draft token 合并和 speculative computed-token 更新。",
      "expected_operators": [
        "_combine_sampled_and_draft_tokens_kernel",
        "_post_update_num_computed_tokens_kernel",
        "speculator._prepare_prefill_inputs_kernel",
        "_prepare_decode_inputs_kernel",
        "_update_draft_inputs_kernel"
      ],
      "model": "/mnt/weight/Qwen3-8B",
      "replace_hot_sampling": true,
      "engine": {
        "speculative_config": {
          "model": "/mnt/weight/Qwen3-8B-speculator.eagle3",
          "method": "eagle3",
          "num_speculative_tokens": 3
        }
      },
      "cases": [
        {
          "name": "eagle_decode",
          "count": 8,
          "prompt_tokens": 256,
          "prompt_text": "Explain speculative decoding in detail. ",
          "sampling": {
            "max_tokens": 16,
            "temperature": 0.0,
            "ignore_eos": true,
            "seed": 42
          }
        }
      ]
    },
    {
      "id": "T4",
      "name": "MRV2 DFlash Greedy + Probabilistic",
      "purpose": "用一个 DFlash 场景覆盖输入准备、logits 统计、greedy/probabilistic rejection、重采样、插入及 speculative logprob 展平。",
      "expected_operators": [
        "_prepare_dflash_inputs_kernel_ascend",
        "_flatten_sampled_kernel",
        "_compute_block_stats_kernel",
        "_probabilistic_rejection_kernel",
        "_resample_kernel",
        "_insert_resampled_kernel"
      ],
      "model": "/mnt/weight/Qwen3-8B",
      "replace_hot_sampling": true,
      "engine": {
        "speculative_config": {
          "model": "/mnt/weight/Qwen3-8B-DFlash-b16",
          "method": "dflash",
          "num_speculative_tokens": 8
        }
      },
      "cases": [
        {
          "name": "dflash_greedy",
          "count": 8,
          "prompt_tokens": 256,
          "prompt_text": "Develop a long reasoning chain about compiler optimization. ",
          "sampling": {
            "max_tokens": 32,
            "temperature": 0.0,
            "logprobs": 4,
            "ignore_eos": true,
            "seed": 42
          }
        },
        {
          "name": "dflash_probabilistic",
          "count": 8,
          "prompt_tokens": 256,
          "prompt_text": "Explain several alternative compiler optimization strategies and compare their tradeoffs. ",
          "sampling": {
            "max_tokens": 64,
            "temperature": 1.0,
            "top_k": 50,
            "top_p": 0.9,
            "logprobs": 4,
            "ignore_eos": true,
            "seed": 123
          }
        }
      ]
    }
  ]
}
